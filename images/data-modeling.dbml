// pokerdf star schema — the source of the data model diagram.
// Paste into dbdiagram.io and export as data-modeling-vX.Y.svg
// (see README.md in this folder for the versioning rules)

Table dim_tournament {
  TournID integer [pk]
  Owner varchar [pk]
  LocalStartTime timestamp
  Modality varchar
  BuyIn varchar
}

Table fact_player_actions {
  TournID integer [not null]
  HandID integer [not null]
  Owner varchar
  LocalTime timestamp
  TableSize integer
  Playing integer
  Level integer
  Ante float
  SmallBlind float
  BigBlind float
  Round varchar
  Player varchar [not null]
  Seat integer
  Position varchar
  Stack float
  PostedAnte float
  PostedBlind float
  Action varchar
  ActionIndex integer
  ActionOrder integer
  AddedValue float
  TotalValue float
  TotalPot float
  BoardC1 varchar
  BoardC2 varchar
  BoardC3 varchar
  BoardC4 varchar
  BoardC5 varchar
  OwnerC1 varchar
  OwnerC2 varchar
  OwnerCombination varchar
  OwnerCombinationScore integer
  RevealedShowDownC1 varchar
  RevealedShowDownC2 varchar
  RevealedShowDownCombination varchar
  RevealedShowDownCombinationScore integer
  RevealedShowDownPokerHand varchar
  Result varchar
  Balance float
}

Table dim_final_rank {
  TournID integer [pk]
  Player varchar [pk]
  FinalRank integer
  Prize float
}

Ref: fact_player_actions.TournID > dim_tournament.TournID
Ref: fact_player_actions.Owner > dim_tournament.Owner
Ref: fact_player_actions.TournID > dim_final_rank.TournID
Ref: fact_player_actions.Player > dim_final_rank.Player
